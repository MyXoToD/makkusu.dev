---
title: Blog
pagination:
  data: collections.blog
  size: 10
  alias: posts
permalink: "/blog/{% if pagination.pageNumber > 0 %}page-{{ pagination.pageNumber + 1 }}/{% endif %}"
styles:
  - css/posts.css
scripts:
  - js/posts.js
---

<div class="content">
  <div class="posts">
    {% for post in posts %}
      <a href="{{ post.url }}" class="post">
        <div class="post__image">
          <img src="{{ post.data.cover }}" alt="{{ post.data.title }}">
        </div>
        <div class="post__title">{{ post.data.title }}</div>
        <div class="post__excerpt">{{ post.data.excerpt }}</div>
      </a>
    {% endfor %}
  </div>
</div>